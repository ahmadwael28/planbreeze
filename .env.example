# Copy to .env.local for local development (it is git-ignored).
# Both values are public: they ship inside the website. Row-level security in the database
# (supabase/schema.sql) is what keeps each user's plans private.
# Never put the Supabase secret / service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
